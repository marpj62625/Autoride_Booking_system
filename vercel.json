{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "maxDuration": 60
      }
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    },
    {
      "src": "admin_mobile/www/**",
      "use": "@vercel/static"
    },
    {
      "src": "admin_app/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/public/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/locations",
      "dest": "/api/index.py"
    },
    {
      "src": "/locations/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/admin/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/addons",
      "dest": "/api/index.py"
    },
    {
      "src": "/addons/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/admin_mobile/(.*)",
      "dest": "/admin_mobile/www/$1"
    },
    {
      "src": "/admin_app/(.*)",
      "dest": "/admin_app/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*).(css|js|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|otf)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
