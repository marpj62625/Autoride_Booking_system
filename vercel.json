{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    },
    {
      "src": "admin_app/**",
      "use": "@vercel/static"
    },
    {
      "src": "admin_mobile/www/**",
      "use": "@vercel/static"
    },
    {
      "src": "customer_mobile/www/**",
      "use": "@vercel/static"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "api/index.py"
    },
    {
      "source": "/admin_app/(.*)",
      "destination": "admin_app/$1"
    },
    {
      "source": "/admin_mobile/(.*)",
      "destination": "admin_mobile/www/$1"
    },
    {
      "source": "/customer/(.*)",
      "destination": "customer_mobile/www/$1"
    },
    {
      "source": "/(.*)",
      "destination": "frontend/$1"
    }
  ]
}
