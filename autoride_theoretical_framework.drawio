        <mxCell id="input_header" parent="QQxhCsp-Hkec8rBMu7C_-2" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#0284c7;strokeColor=#0369a1;strokeWidth=2;fontSize=34;fontStyle=1;fontFamily=Segoe UI;fontColor=#ffffff;align=center;" value="1. THEORETICAL INPUT (GST INGESTION)" vertex="1">
          <mxGeometry height="85" width="1390" x="30" y="1050" as="geometry" />
        </mxCell>
        <mxCell id="input_def" parent="QQxhCsp-Hkec8rBMu7C_-2" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;strokeWidth=2;fontSize=28;fontStyle=1;fontFamily=Segoe UI;fontColor=#0369a1;" value="Environmental Ingestion &amp; Foundational Frameworks" vertex="1">
          <mxGeometry height="75" width="1390" x="30" y="1155" as="geometry" />
        </mxCell>
        <mxCell id="input_content" parent="QQxhCsp-Hkec8rBMu7C_-2" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#bae6fd;strokeWidth=1.5;align=left;verticalAlign=top;fontFamily=Segoe UI;" value="&lt;div style=&quot;padding: 24px 28px; text-align: left; line-height: 1.7; color: rgb(30, 41, 59);&quot;&gt; &lt;font style=&quot;font-size: 37px;&quot;&gt;&lt;b style=&quot;color: rgb(3, 105, 161);&quot;&gt;A. Theoretical Paradigms &amp;amp; Principles:&lt;/b&gt;&lt;br&gt; • &lt;b style=&quot;&quot;&gt;General Systems Theory (von Bertalanffy, 1968):&lt;/b&gt; Conceptualizes car rental enterprise as holistic, interrelated subsystems (Client, Dispatch, DB, Finance)&lt;br&gt; • &lt;b style=&quot;&quot;&gt;Cybernetics (Wiener, 1948):&lt;/b&gt; Information feedback loops for self-regulation and error-correcting homeostasis&lt;br&gt; &lt;/font&gt;&lt;hr style=&quot;border-width: 2px 0px 0px; border-style: dashed none none; border-color: rgb(186, 230, 253) currentcolor currentcolor; border-image: none; margin: 16px 0px;&quot;&gt; &lt;font style=&quot;font-size: 37px;&quot;&gt;&lt;b style=&quot;color: rgb(3, 105, 161);&quot;&gt;B. Empirical Existing System Defect Baseline:&lt;/b&gt;&lt;br&gt; • Scheduling collisions &amp;amp; lack of real-time multi-staff calendar locks in Manual Setup&lt;br&gt; • Prohibitive recurring subscription cost &amp;amp; lack of PH fintech in Enterprise SaaS&lt;br&gt; &lt;/font&gt;&lt;hr style=&quot;border-width: 2px 0px 0px; border-style: dashed none none; border-color: rgb(186, 230, 253) currentcolor currentcolor; border-image: none; margin: 16px 0px;&quot;&gt; &lt;font style=&quot;font-size: 37px;&quot;&gt;&lt;b style=&quot;color: rgb(3, 105, 161);&quot;&gt;C. Domain Data &amp;amp; Operational Parameters:&lt;/b&gt;&lt;br&gt; • Customer KYC &amp;amp; Licensure (LTO Validated IDs, contact profiles)&lt;br&gt; • Fleet Asset Ingestion (Units, daily rates, owner-consignor shares)&lt;br&gt; • Temporal Schedules &amp;amp; Blackout Rules (2-month fleet timeline grid)&lt;br&gt; • Financial rails (PayMongo GCash/Maya &amp;amp; Cash downpayment/balance) &lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="1420" width="1390" x="30" y="1250" as="geometry" />
        </mxCell>
        <mxCell id="box_process" parent="QQxhCsp-Hkec8rBMu7C_-2" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#7c3aed;strokeWidth=3;shadow=1;" value="" vertex="1">
