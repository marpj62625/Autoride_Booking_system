        <mxCell id="fb_card_a" parent="QQxhCsp-Hkec8rBMu7C_-1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fde68a;strokeWidth=2;align=left;verticalAlign=middle;fontFamily=Segoe UI;" value="&lt;div style=&quot;padding: 24px 28px;&quot;&gt;&lt;div style=&quot;&quot;&gt;&lt;b style=&quot;font-size: 44px; background-color: transparent; color: rgb(180, 83, 9);&quot;&gt;↻ Loop A: Operational Fleet State Feedback&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(71, 85, 105); line-height: 1.7; margin-top: 14px;&quot;&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 44px; background-color: transparent;&quot;&gt;• &lt;/span&gt;&lt;b style=&quot;font-size: 44px; background-color: transparent;&quot;&gt;Automatic Unit Recalibration:&lt;/b&gt;&lt;span style=&quot;font-size: 44px; background-color: transparent;&quot;&gt; Clicking &lt;/span&gt;&lt;i style=&quot;font-size: 44px; background-color: transparent;&quot;&gt;Return Key&lt;/i&gt;&lt;span style=&quot;font-size: 44px; background-color: transparent;&quot;&gt; instantly triggers a database state mutation, releasing the vehicle back to &lt;/span&gt;&lt;b style=&quot;font-size: 44px; background-color: transparent;&quot;&gt;Available&lt;/b&gt;&lt;span style=&quot;font-size: 44px; background-color: transparent;&quot;&gt; inventory.&lt;/span&gt;&lt;/div&gt;&lt;font style=&quot;font-size: 44px;&quot;&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;• &lt;/span&gt;&lt;b style=&quot;background-color: transparent;&quot;&gt;Maintenance Routing:&lt;/b&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt; If return inspection flags damage or high mileage, unit is auto-rerouted to Maintenance blackout status.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;• &lt;/span&gt;&lt;b style=&quot;background-color: transparent;&quot;&gt;Target Destination:&lt;/b&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt; Feeds directly into &lt;/span&gt;&lt;b style=&quot;background-color: transparent;&quot;&gt;Theoretical Input&lt;/b&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt; to maintain exact real-world inventory equilibrium.&lt;/span&gt;&lt;/div&gt;&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="915" width="1420" x="30" y="235" as="geometry" />
        </mxCell>
        <mxCell id="fb_card_b" parent="QQxhCsp-Hkec8rBMu7C_-1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fde68a;strokeWidth=2;align=left;verticalAlign=middle;fontFamily=Segoe UI;" value="&lt;div style=&quot;padding: 24px 28px; text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 41px;&quot;&gt;&lt;b style=&quot;color: rgb(180, 83, 9);&quot;&gt;⚡ Loop B: Dynamic Collision &amp;amp; Financial Telemetry&lt;/b&gt;&lt;br&gt;&lt;/font&gt;&lt;div style=&quot;color: rgb(71, 85, 105); line-height: 1.7; margin-top: 14px;&quot;&gt;&lt;font style=&quot;font-size: 41px;&quot;&gt;• &lt;b style=&quot;&quot;&gt;Live Timeline Interception:&lt;/b&gt; Every booking attempt triggers algorithmic date collision checks against ongoing reservations, returning immediate conflict flags.&lt;br&gt;• &lt;b style=&quot;&quot;&gt;Webhook Reconciliation:&lt;/b&gt; PayMongo automated payment responses re-calculate outstanding balances, updating payment status in real-time.&lt;br&gt;• &lt;b style=&quot;&quot;&gt;Target Destination:&lt;/b&gt; Feeds back into &lt;b style=&quot;&quot;&gt;Theoretical Process&lt;/b&gt; to dynamically calibrate transformation rules.&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
