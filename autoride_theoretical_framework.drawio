        <mxCell id="benchmark_title" parent="QQxhCsp-Hkec8rBMu7C_-2" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#334155;strokeColor=#1e293b;strokeWidth=2;fontSize=30;fontStyle=1;fontFamily=Segoe UI;fontColor=#f8fafc;align=center;" value="THEORETICAL ANCHOR 1: COMPARATIVE BENCHMARK MATRIX (EXISTING SYSTEMS VS. PROPOSED AUTORIDE SYSTEM)" vertex="1">
          <mxGeometry height="75" width="4640" x="30" y="295" as="geometry" />
        </mxCell>
        <mxCell id="card_exist_a" parent="QQxhCsp-Hkec8rBMu7C_-2" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff1f2;strokeColor=#f43f5e;strokeWidth=2.5;align=left;verticalAlign=middle;fontFamily=Segoe UI;" value="&lt;div style=&quot;padding: 18px 24px; text-align: left;&quot;&gt;&lt;b style=&quot;color:#be123c; font-size:32px;&quot;&gt;Existing System A: Traditional Manual / Messenger Setup&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;font-size:30px; color:#475569; line-height:1.6; margin-top:10px;&quot;&gt;&amp;bull; &lt;b&gt;Mechanism:&lt;/b&gt; Paper logbooks, Facebook Messenger chats, unlinked spreadsheets&lt;br/&gt;&amp;bull; &lt;b&gt;Scheduling Defect:&lt;/b&gt; Zero collision prevention; high frequency of catastrophic double-bookings&lt;br/&gt;&amp;bull; &lt;b&gt;Dispatch Latency:&lt;/b&gt; 15&amp;ndash;25 minutes per vehicle handover (handwritten forms &amp;amp; keys)&lt;br/&gt;&amp;bull; &lt;b&gt;Payment Proof:&lt;/b&gt; Unverified manual GCash screenshots prone to tampering and fraud&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="525" width="1420" x="30" y="395" as="geometry" />
        </mxCell>
        <mxCell id="card_exist_b" parent="QQxhCsp-Hkec8rBMu7C_-2" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fefce8;strokeColor=#ca8a04;strokeWidth=2.5;align=left;verticalAlign=middle;fontFamily=Segoe UI;" value="&lt;div style=&quot;padding: 18px 24px; text-align: left;&quot;&gt;&lt;b style=&quot;color:#a16207; font-size:32px;&quot;&gt;Existing System B: International SaaS (HQ Rental / Rentcentric)&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;font-size:30px; color:#475569; line-height:1.6; margin-top:10px;&quot;&gt;&amp;bull; &lt;b&gt;Mechanism:&lt;/b&gt; Enterprise cloud SaaS built for global corporate rental conglomerates&lt;br/&gt;&amp;bull; &lt;b&gt;Cost Prohibitive:&lt;/b&gt; Heavy recurring USD subscription fees per vehicle/month&lt;br/&gt;&amp;bull; &lt;b&gt;Localization Gap:&lt;/b&gt; Lacks native Philippine QRPh, Maya, GCash API integrations&lt;br/&gt;&amp;bull; &lt;b&gt;Consignor Handling:&lt;/b&gt; No native multi-party peer consignor profit-sharing architecture&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="525" width="1420" x="1640" y="395" as="geometry" />
        </mxCell>
        <mxCell id="card_proposed" parent="QQxhCsp-Hkec8rBMu7C_-2" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=3;align=left;verticalAlign=middle;fontFamily=Segoe UI;" value="&lt;div style=&quot;padding: 18px 24px; text-align: left;&quot;&gt;&lt;b style=&quot;color:#15803d; font-size:32px;&quot;&gt;Proposed System: Autoride Full-Stack Ecosystem&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;font-size:30px; color:#1e293b; line-height:1.6; margin-top:10px;&quot;&gt;&amp;bull; &lt;b&gt;Cybernetic Architecture:&lt;/b&gt; Closed-loop feedback with automated fleet state calibration&lt;br/&gt;&amp;bull; &lt;b&gt;Collision Prevention:&lt;/b&gt; Minute-accurate timeline algorithm guaranteeing 0% overlaps&lt;br/&gt;&amp;bull; &lt;b&gt;Rapid 1-Click Operations:&lt;/b&gt; Hand Over Key &amp;amp; Return Key turnaround under 30 seconds&lt;br/&gt;&amp;bull; &lt;b&gt;Native Localization:&lt;/b&gt; PayMongo automated webhooks (GCash/Maya) &amp;amp; Consignor splits&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="525" width="1420" x="3250" y="395" as="geometry" />
        </mxCell>
        <mxCell id="box_input" parent="QQxhCsp-Hkec8rBMu7C_-2" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f0f9ff;strokeColor=#0284c7;strokeWidth=3;shadow=1;" value="" vertex="1">
          <mxGeometry height="1680" width="1450" y="1020" as="geometry" />
