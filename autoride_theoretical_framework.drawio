        <mxCell id="output_content" parent="QQxhCsp-Hkec8rBMu7C_-2" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#bbf7d0;strokeWidth=1.5;align=left;verticalAlign=top;fontFamily=Segoe UI;" value="&lt;div style=&quot;padding: 24px 28px; text-align: left; line-height: 1.7; color: rgb(30, 41, 59);&quot;&gt; &lt;font style=&quot;font-size: 43px;&quot;&gt;&lt;b style=&quot;color: rgb(21, 128, 61);&quot;&gt;A. Verified Operational Software Artifact:&lt;/b&gt;&lt;br&gt; • &lt;b style=&quot;&quot;&gt;The Autoride System:&lt;/b&gt; Fully functional responsive web platform &amp;amp; Android mobile application prototype&lt;br&gt; • 100% feature symmetry between desktop administrative suite and mobile yard tools&lt;br&gt; &lt;/font&gt;&lt;hr style=&quot;border-width: 2px 0px 0px; border-style: dashed none none; border-color: rgb(187, 247, 208) currentcolor currentcolor; border-image: none; margin: 16px 0px;&quot;&gt; &lt;font style=&quot;font-size: 43px;&quot;&gt;&lt;b style=&quot;color: rgb(21, 128, 61);&quot;&gt;B. Operational Deliverables &amp;amp; Outcomes:&lt;/b&gt;&lt;br&gt; • &lt;b style=&quot;&quot;&gt;Zero-Collision Guarantee:&lt;/b&gt; 0% double-booking occurrence validated across operational testing&lt;br&gt; • &lt;b style=&quot;&quot;&gt;Accelerated Dispatch:&lt;/b&gt; Turnaround time reduced from 25 min (manual) to &amp;lt;30 sec (digital)&lt;br&gt; • &lt;b style=&quot;&quot;&gt;Cryptographic QR Rental Vouchers:&lt;/b&gt; Real-time proof of reservation &amp;amp; contract validation&lt;br&gt; • &lt;b style=&quot;&quot;&gt;Tamper-Resistant Audit Records:&lt;/b&gt; Automated logs of staff actions, vehicle transitions, and payments &lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="1420" width="1390" x="3280" y="1250" as="geometry" />
        </mxCell>
