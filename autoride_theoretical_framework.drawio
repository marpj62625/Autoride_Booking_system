        <mxCell id="header_container" parent="QQxhCsp-Hkec8rBMu7C_-2" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#1e293b;strokeWidth=3;shadow=1;align=center;verticalAlign=middle;fontFamily=Segoe UI;" value="&lt;div style=&quot;text-align: center; line-height: 1.4;&quot;&gt;&lt;b style=&quot;font-size: 46px; color: #ffffff; letter-spacing: 0.5px;&quot;&gt;THEORETICAL FRAMEWORK: AUTORIDE FLEET &amp;amp; BOOKING ECOSYSTEM&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 26px; color: #94a3b8; font-weight: 600;&quot;&gt;Anchored on General Systems Theory (Ludwig von Bertalanffy, 1968), Cybernetic Control Theory (Norbert Wiener, 1948), and Comparative Benchmark Against Existing Systems&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="220" width="4700" as="geometry" />
        </mxCell>
        <mxCell id="box_benchmark_wrapper" parent="QQxhCsp-Hkec8rBMu7C_-2" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=2.5;shadow=1;" value="" vertex="1">
