# =============================================================================
# AUTORIDE BOOKING SYSTEM - PRODUCTION ENVIRONMENT CONFIGURATION (.env)
# =============================================================================
# Duplicate this file as .env (or add these keys to Vercel Environment Variables).

# --- DATABASE (Supabase PostgreSQL) ---
# Use the Transaction Pooler connection string (port 6543) for serverless environments.
SUPABASE_DB_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres

# --- FLASK SECURITY ---
SECRET_KEY=generate_a_long_random_string_for_production
DEBUG=False

# --- PAYMONGO PAYMENT GATEWAY ---
# Set to 'live' in production settings table or env
PAYMONGO_SECRET_KEY=sk_live_YOUR_PAYMONGO_LIVE_SECRET_KEY
PAYMONGO_PUBLIC_KEY=pk_live_YOUR_PAYMONGO_LIVE_PUBLIC_KEY
# Copy this from PayMongo Dashboard > Developers > Webhooks
PAYMONGO_WEBHOOK_SECRET=whsec_YOUR_PAYMONGO_WEBHOOK_SIGNING_SECRET

# Application Base URL (No trailing slash)
APP_BASE_URL=https://autoride-booking-system.vercel.app

# --- FIREBASE CLOUD MESSAGING (Push Notifications) ---
# Single-line JSON string of your Firebase Service Account private key
# Run: python scratch/get_firebase_env.py to generate this string
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"..."}

# --- VERCEL CRON / BACKGROUND SCHEDULER SECURITY ---
# Optional secret to secure the /api/cron/tick endpoint
CRON_SECRET=your_secret_cron_token_here

# --- GOOGLE OAUTH ---
GOOGLE_CLIENT_ID=857792394948-9m57q54s4638muf0ab5ihgakj4g44lje.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=

# --- EMAIL NOTIFICATIONS (Gmail SMTP) ---
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_USER=your_company_email@gmail.com
EMAIL_PASS=your_gmail_app_password
